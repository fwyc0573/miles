+    before = _contents(native_root)
+    with pytest.raises(ValueError, match="KV stream|Runtime metadata"):
+        _prepare(native_root, tmp_path / "witness")
+    assert _contents(native_root) == before
+    assert not (tmp_path / "witness").exists()
