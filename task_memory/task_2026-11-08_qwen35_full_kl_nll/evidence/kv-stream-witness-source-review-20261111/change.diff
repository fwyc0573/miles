+_EVIDENCE = (Path(__file__).resolve().parents[2]
+             / "task_memory/task_2026-11-08_qwen35_full_kl_nll/evidence/native-sglang-cache-source-20261111"
+             / witness._SOURCE_JOB / "source")
+
