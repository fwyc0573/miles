+def test_recurrent_error_isolation_mode_scope_publication_join_and_incomplete_drain(monkeypatch):
+    collector, _, conv, temporal = _recurrent_toy(monkeypatch)
+    monkeypatch.setattr(coherence, "_collector", collector)
