+def _drain(recorder):
+    return recorder["drain"](SimpleNamespace(dp_rank=1, tp_rank=2, pp_rank=0, attn_dp_rank=1, attn_tp_rank=0))
+
+
+def _events(recorder):
+    return [(event, dict(fields)) for _, event, fields in _drain(recorder)["rows"]]
